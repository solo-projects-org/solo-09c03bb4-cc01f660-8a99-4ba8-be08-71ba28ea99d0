# 复制为 .env 后可被 docker compose 自动读取；下列均为默认值
APP_AET=RETRIEVER
PACS_AET=MYPACS
STORE_PORT=11113
PACS_PORT=11112
# 模拟 PACS 每个实例发送间隔（秒），调大可更清楚观察交错回传
MOVE_DELAY=1.0
# 每 N 个实例重复投送一次（0 关闭）
MOVE_DUPLICATE_EVERY=3
# 三个虚构检查各自的 CT 实例数
STUDY_COUNTS=8,6,5
# 几何检查演示用缺陷检查：all=缺层/重层/层距异常/方向不一致/标签缺失/单片
# 也可逗号指定子集，如 missing,duplicate；置空则只生成正常检查
DEFECT_STUDIES=all
